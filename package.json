{
  "name": "educ-data-concept",
  "version": "1.22.0",
  "private": true,
  "description": "Sistema de Introdução e Painel de Indicadores das Estatísticas da Educação da Província de Tete (EducStat / AdultStat). Para Windows, funciona sem internet.",
  "homepage": "https://github.com/albertoadelia/edu-data-concept#readme",
  "bugs": {
    "url": "https://github.com/albertoadelia/edu-data-concept/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertoadelia/edu-data-concept.git"
  },
  "license": "UNLICENSED",
  "author": "Alberto Adélia Manhice",
  "type": "commonjs",
  "main": "main.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "verificar": "node scripts/verificar-dados.js",
    "dist": "node scripts/verificar-dados.js && node --test tests/*.test.js && electron-builder --win nsis portable --x64",
    "manifesto": "node scripts/verificar-dados.js --manifesto"
  },
  "dependencies": {
    "mdb-reader": "3.1.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "EducStat Tete",
  "build": {
    "appId": "mz.gov.tete.dpe.educstat",
    "productName": "EducStat Tete",
    "copyright": "© 2026 Alberto Adélia Manhice — DPE Tete",
    "files": [
      "main.js",
      "preload.js",
      "conversor.js",
      "app/**/*",
      "build/icon.png",
      "package.json",
      "exportador.js",
      "lib/**/*",
      "docxgraficos.js",
      "xlsxgraficos.js",
      "!app/v14.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "DPE Tete",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EducStat Tete",
      "language": "2070",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "EducStat_Tete_Instalador_${version}.${ext}"
    },
    "portable": {
      "artifactName": "EducStat_Tete_Portatil_${version}.${ext}"
    }
  }
}
